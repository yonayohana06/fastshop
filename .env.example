# ==============================================================================
# FastShop Storefront - Environment Variables Template
# Salin berkas ini menjadi .env.local untuk konfigurasi lokal:
# cp .env.example .env.local
# ==============================================================================

# URL Backend REST API
# Gunakan URL API backend e-commerce (lokal atau cloud)
NEXT_PUBLIC_API_URL=https://ecommerce-backend-api-nu.vercel.app/api

# URL Publik Storefront FastShop (Digunakan untuk SEO, Canonical URL, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
